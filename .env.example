# AI Protector India — HackerWrath 3.0 Environment Configuration
# Copy this file to .env.local and configure required keys.
# NEVER commit .env.local or real API credentials to git.

# Environment
NODE_ENV=development
PORT=3000

# Security & API Secrets
# 1. Google Web Risk / Safe Browsing API Key (Non-commercial evaluation)
# Free tier setup: https://cloud.google.com/web-risk/docs/lookup-api
# Note: Imperfect protection notice and Safe Browsing attribution must be shown on client
WEBRISK_API_KEY=

# 2. Google Gemini API Key for AI Security Copilot & Policy Reasoning (Optional)
# In-memory heuristic fallbacks are active if left blank.
GEMINI_API_KEY=

# 3. Have I Been Pwned (HIBP) API Key for Live Email Breach Queries (Optional)
# If empty, the system automatically uses the curated offline Indian breach table (BigBasket, Air India, Domino's India)
HIBP_API_KEY=

# 4. VirusTotal API Key for multi-engine file hash lookups (Optional)
VIRUSTOTAL_API_KEY=

# Database Connection (PostgreSQL / Neon)
# Zero-knowledge architecture: Local browser storage used by default.
DATABASE_URL=

# Authentication Secret for session tokens
AUTH_SECRET=ai-protector-dev-secret-replace-in-production-min-32-chars

# Security & Rate Limiting
RATE_LIMIT_MAX_PER_MINUTE=60
